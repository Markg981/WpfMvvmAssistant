<Window x:Class="UI.Wpf.Views.ConnectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:UI.Wpf.Helpers"
        Title="Connection Manager" 
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="Saved Connections" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <Button DockPanel.Dock="Bottom" 
                    Content="New Connection" 
                    Command="{Binding NewCommand}"
                    Margin="0,10,0,0"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            
            <ListBox ItemsSource="{Binding Connections}"
                     SelectedItem="{Binding SelectedConnection}"
                     DisplayMemberPath="Name"/>
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Connection Details" FontWeight="Bold" FontSize="16" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1">
                <TextBox materialDesign:HintAssist.Hint="Connection Name"
                         Text="{Binding ConnectionName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,15"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                <TextBox materialDesign:HintAssist.Hint="Server Name"
                         Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,15"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                <TextBox materialDesign:HintAssist.Hint="Database Name"
                         Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,15"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                <CheckBox Content="Use Windows Authentication"
                          IsChecked="{Binding UseWindowsAuth}"
                          Margin="0,0,0,15"/>

                <TextBox materialDesign:HintAssist.Hint="Username"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,15"
                         IsEnabled="{Binding UseWindowsAuth, Converter={StaticResource InverseBooleanConverter}}"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                <PasswordBox helpers:PasswordBoxHelper.Attach="True"
                             helpers:PasswordBoxHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Password"
                             Margin="0,0,0,15"
                             IsEnabled="{Binding UseWindowsAuth, Converter={StaticResource InverseBooleanConverter}}"
                             Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"/>
            </StackPanel>

            <TextBlock Grid.Row="2" 
                       Text="{Binding StatusMessage}"
                       Margin="0,10,0,10"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialDesignBody}"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Test Connection"
                        Command="{Binding TestConnectionCommand}"
                        Margin="0,0,10,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Margin="0,0,10,0"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                
                <Button Content="Delete"
                        Command="{Binding DeleteCommand}"
                        Margin="0,0,10,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                
                <Button Content="Close"
                        Click="CloseButton_Click"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
