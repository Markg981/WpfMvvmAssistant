<UserControl x:Class="UI.Wpf.Views.QueryEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="150"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*" MinHeight="200"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0" Background="{DynamicResource MaterialDesignPaper}">
            <Button Command="{Binding ExecuteSqlCommand}" 
                    ToolTip="Execute SQL (F5)"
                    Style="{StaticResource MaterialDesignRaisedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Play" Height="18" Width="18"/>
                    <TextBlock Text="Execute SQL" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
            
            <Button Command="{Binding ExecuteEfCommand}"
                    ToolTip="Execute EF LINQ"
                    Margin="5,0,0,0"
                    Style="{StaticResource MaterialDesignOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CodeBraces" Height="18" Width="18"/>
                    <TextBlock Text="Execute EF" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>

            <Separator/>

            <Button Command="{Binding ClearCommand}"
                    ToolTip="Clear Editor"
                    Style="{StaticResource MaterialDesignFlatButton}">
                <materialDesign:PackIcon Kind="Close" Height="18" Width="18"/>
            </Button>
        </ToolBar>

        <GroupBox Grid.Row="1" Header="SQL/LINQ Query" Margin="5">
            <TextBox Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="12"/>
        </GroupBox>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>

        <GroupBox Grid.Row="3" Header="Natural Language Query" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding NaturalLanguageText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Enter natural language query (e.g., Show me all active customers)"
                         Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding TranslateNlCommand}"
                            Content="Translate"
                            Margin="0,0,5,0"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                    
                    <Button Command="{Binding ExecuteNlCommand}"
                            Content="Execute"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <TabControl Grid.Row="4" Margin="5">
            <TabItem Header="Results">
                <DataGrid ItemsSource="{Binding Results}"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          CanUserReorderColumns="True"
                          GridLinesVisibility="All"
                          AlternatingRowBackground="{DynamicResource MaterialDesignDivider}"/>
            </TabItem>
            
            <TabItem Header="Generated SQL">
                <TextBox Text="{Binding GeneratedSql, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto"/>
            </TabItem>
            
            <TabItem Header="Generated LINQ">
                <TextBox Text="{Binding GeneratedLinq, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto"/>
            </TabItem>
            
            <TabItem Header="Translation Info">
                <StackPanel Margin="10">
                    <TextBlock Text="Explanation:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding TranslationExplanation, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Confidence:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ProgressBar Value="{Binding Confidence}"
                                 Maximum="1.0"
                                 Height="20"
                                 Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Confidence, StringFormat='{}{0:P0}'}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </TabItem>
            
            <TabItem Header="Messages">
                <TextBox Text="{Binding StatusMessage, Mode=OneWay}"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
