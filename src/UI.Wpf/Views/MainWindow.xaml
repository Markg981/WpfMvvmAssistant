<Window x:Class="UI.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:UI.Wpf.ViewModels"
        Title="SQL Studio Pro" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="{DynamicResource MaterialDesignPaper}">
            <MenuItem Header="_File">
                <MenuItem Header="New _Connection" Command="{Binding NewConnectionCommand}"/>
                <MenuItem Header="New _Query" Command="{Binding NewQueryCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Format Query"/>
                <MenuItem Header="_Clear Results"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Toggle _Theme" Command="{Binding ToggleThemeCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About"/>
            </MenuItem>
        </Menu>

        <ToolBar Grid.Row="1" Background="{DynamicResource MaterialDesignPaper}" Padding="5">
            <Button Command="{Binding NewConnectionCommand}" 
                    ToolTip="New Connection"
                    Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DatabasePlus" Height="20" Width="20"/>
                    <TextBlock Text="Connect" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding NewQueryCommand}"
                    ToolTip="New Query"
                    Style="{StaticResource MaterialDesignFlatButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FilePlus" Height="20" Width="20"/>
                    <TextBlock Text="New Query" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding ToggleThemeCommand}"
                    ToolTip="Toggle Theme"
                    Style="{StaticResource MaterialDesignFlatButton}">
                <materialDesign:PackIcon Kind="ThemeLightDark" Height="20" Width="20"/>
            </Button>
        </ToolBar>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" 
                               Text="Object Explorer" 
                               FontWeight="Bold" 
                               Margin="10"
                               FontSize="14"/>
                    
                    <Grid>
                        <TextBlock Text="Connect to database to view schema" 
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="10"
                                   Visibility="{Binding CurrentSchema, Converter={StaticResource InvertedNullToVisibilityConverter}}"/>
                        
                        <ScrollViewer Visibility="{Binding CurrentSchema, Converter={StaticResource NullToVisibilityConverter}}">
                            <TreeView x:Name="SchemaTreeView"
                                      Margin="5"
                                      Background="Transparent">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:SchemaTreeItem}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="{Binding Icon}" Height="16" Width="16" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Name}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" 
                           Text="Query Editor" 
                           FontWeight="Bold" 
                           Margin="10"
                           FontSize="14"/>
                
                <TabControl x:Name="QueryTabControl" 
                            Margin="5">
                    <TabItem Header="Welcome">
                        <ScrollViewer>
                            <StackPanel Margin="20" MaxWidth="600">
                                <TextBlock Text="Welcome to SQL Studio Pro" 
                                           FontSize="24" 
                                           FontWeight="Bold"
                                           Margin="0,0,0,20"/>
                                
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,15">
                                    A professional SQL Server Management Studio clone with Natural Language Processing capabilities.
                                </TextBlock>

                                <TextBlock Text="Quick Start:" FontWeight="Bold" Margin="0,10,0,5"/>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                    1. Click "Connect" to add a database connection<LineBreak/>
                                    2. Browse the schema in the Object Explorer<LineBreak/>
                                    3. Click "New Query" to start writing SQL<LineBreak/>
                                    4. Use natural language queries for AI-powered SQL generation
                                </TextBlock>

                                <TextBlock Text="Features:" FontWeight="Bold" Margin="0,10,0,5"/>
                                <TextBlock TextWrapping="Wrap">
                                    • Multi-tab SQL query editor with syntax highlighting<LineBreak/>
                                    • Natural language to SQL translation<LineBreak/>
                                    • Schema browser with tables, views, stored procedures<LineBreak/>
                                    • Query results with export to CSV<LineBreak/>
                                    • Secure connection management with encryption<LineBreak/>
                                    • Light and dark themes
                                </TextBlock>

                                <TextBlock Text="Note:" FontWeight="Bold" Margin="0,20,0,5" Foreground="OrangeRed"/>
                                <TextBlock TextWrapping="Wrap" Foreground="OrangeRed">
                                    This is a Windows desktop application. Download all files and run on Windows 10/11 with .NET 8 SDK.
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Grid>

        <StatusBar Grid.Row="3" Background="{DynamicResource MaterialDesignPaper}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready'}" />
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding SelectedConnection.Name, StringFormat='Connected to: {0}', FallbackValue='Not connected'}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
